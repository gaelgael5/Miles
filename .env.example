# Modèle de .env — le vrai .env est créé sur l'hôte par dev-deploy.sh et n'est jamais versionné.
# MILES_DB_PASSWORD est généré automatiquement s'il manque, et n'est jamais régénéré ensuite.
MILES_DB_PASSWORD=
# Compte du back-office auprès du broker MQTT : généré une fois par dev-deploy.sh.
MILES_MQTT_PASSWORD=
# Clé des secrets de l'instance (base64 url-safe, 32 octets) : générée une fois par
# dev-deploy.sh, JAMAIS régénérée — les secrets chiffrés en base deviendraient illisibles.
MILES_SECRETS_KEY=
# Adresse publique du portail, d'où se déduit l'URL de retour OIDC
# (<adresse>/api/auth/oidc/callback). Inscrite par dev-deploy.sh d'après l'annuaire.
MILES_PUBLIC_URL=
# Port publié du broker pour les terminaux (figé au premier passage).
MILES_MQTT_PORT=1883
# Port publié : choisi au premier passage (MILES_HTTP_PORT=… ./dev-deploy.sh), puis figé ici.
MILES_HTTP_PORT=8080
MILES_LOG_LEVEL=info
# Annuaire du portail (non secret, figé au premier passage). Le code TOTP PORTAL_TOKEN n'y est jamais.
EXPOSE_PORTAL_URL=https://dev.yoops.org
EXPOSE_WORKSPACE=miles
EXPOSE_HOST=
# Compte d'amorçage : créé par dev-deploy.sh (machine de test) ou par l'écran d'amorçage.
# Trois entrées ensemble ou aucune ; l'empreinte est argon2id, jamais le mot de passe.
# MILES_ADMIN_EMAIL='admin@example.org'
# MILES_ADMIN_USERNAME='admin'
# MILES_ADMIN_PASSWORD_HASH='$argon2id$...'
